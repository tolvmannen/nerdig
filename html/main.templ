<!DOCTYPE html>
<html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <title>NerDIG</title>
         <meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="style.css">
        <script src="https://unpkg.com/htmx.org@1.7.1/dist/htmx.min.js"></script>
        <script src="https://unpkg.com/htmx.org@1.7.1/dist/ext/json-enc.js"></script>
        <script>
           function copycmd(id) {
                var r = document.createRange();
                r.selectNode(document.getElementById(id));
                window.getSelection().removeAllRanges();
                window.getSelection().addRange(r);
                document.execCommand('copy');
                window.getSelection().removeAllRanges();
            }
        </script>

<style>
.htmx-indicator{opacity:0}
.htmx-request .htmx-indicator{opacity:1; transition: opacity 200ms ease-in;}
.htmx-request.htmx-indicator{opacity:1; transition: opacity 200ms ease-in;}
</style>

</head>
<body>

<input type="checkbox" id="hide_unset" value="true" name="hide_unset" checked=""> 

<section class="header">

    <div class="banner">
        <h1>NerDIG</h1>
    </div>

    <div class="digform">
                <form hx-post="dig/webclient" hx-target="#terminal" hx-swap="innerHTML swap:200ms" hx-headers="{&quot;Content-Type&quot;: &quot;application/json&quot;}" hx-on:htmx:response-error="alert(&#39;ERROR: Request could not be completed&#39;)" hx-on:htmx:send-error="alert(&#39;ERROR: Could not send request&#39;)" hx-ext="json-enc" class="">

        <div class="options">
            <span>
                    <p class="note">Name</p>
                    <input type="text" id="Qname" name="Qname" required="">
            </span>

            <span>

                    <p class="note">Type</p>
                    <input type="text" id="Type" name="Qtype" list="typelist" value="A" required="">

                    <datalist id="typelist">
                        <option value="A"></option>
                        <option value="AAAA"></option>
                        <option value="NS"></option>
                        <option value="MX"></option>
                        <option value="TXT"></option>
                        <option value="SOA"></option>
                        <option value="PTR"></option>
                        <option value="CNAME"></option>
                        <option value="SRV"></option>
                        <option value="NSEC"></option>
                        <option value="RRSIG"></option>
                        <option value="DNSKEY"></option>
                        <option value="CDNSKEY"></option>
                        <option value="DS"></option>
                        <option value="CDS"></option>
                        <option value="NSEC3PARAM"></option>
                        <option value="RP"></option>
                        <option value="AXFR"></option>
                        <option value="ANY"></option>
                    </datalist>
            </span>

            <span>
                    <p class="note">Nameserver</p>
                    <input type="text" id="Nameserver" name="Nameserver" value="1.1.1.1">
            </span>

            <button type="submit">dig</button>


        </div>
        <div class="options">
            <details open="">
                <summary>
                <span class="infotag" hx-get="dig/info/basic-dig-options" hx-target="#infobox" hx-swap="innerHTML">Basic Options:</span>
                </summary>

                <input type="checkbox" id="RD" value="true" name="RD" checked=""> 
                <span>
                <label class="sendflag" for="RD">RD</label>
                </span>
<!--
                <input type="checkbox" id="AA" value="true" name="AA"> 
                <span>
                <label class="sendflag" for="AA">AA</label>
                </span>
-->
                <input type="checkbox" id="AD" value="true" name="AD" checked=""> 
                <span>
                <label class="sendflag" for="AD">AD</label>
                </span>

                <input type="checkbox" id="CD" value="true" name="CD"> 
                <span>
                <label class="sendflag" for="CD">CD</label>
                </span>
                
                <input type="checkbox" id="DO" value="true" name="DO"> 
                <span>
                <label class="sendflag" for="DO">DO</label>
                </span>

                <input type="checkbox" id="NoCrypto" value="true" name="NoCrypto"> 
                <span>
                <label class="sendflag" for="NoCrypto">No Crypto</label>
                </span>

                <input type="checkbox" id="Reverse" value="true" name="Reverse"> 
                <span>
                <label class="sendflag" for="Reverse">Reverse</label>
                </span>

                <input type="checkbox" id="Nsid" value="true" name="Nsid"> 
                <span>
                <label class="sendflag" for="Nsid">Nsid</label>
                </span>

                <input type="checkbox" id="ShowQuery" value="true" name="ShowQuery"> 
                <span>
                <label class="sendflag" for="ShowQuery">Show Query</label>
                </span>

                <select id="Transport" name="Transport" required="">
                    <option value="udp">UDP</option>
                    <option value="tcp">TCP</option>
                </select>
                <select id="IpVersion" name="IpVersion" required="">
                    <option value="4">IPv4</option>
                    <option value="6">IPv6</option>
                </select>
                
            </details>
            
        </div>

        <div class="options">
            <details>
                <summary>
                <span class="infotag" hx-get="dig/info/extra-dig-options" hx-target="#infobox" hx-swap="innerHTML">Extra Options:</span>
                </summary>
                <span>
                    <span hx-get="dig/info/port" hx-target="#infobox" hx-swap="innerHTML">Port: </span>
                    <input size="4" type="text" id="Port" name="Port" value="53" required="">
                </span>
                <span>
                    <span hx-get="dig/info/UDPsize" hx-target="#infobox" hx-swap="innerHTML">UDP size: </span>
                    <input size="4" type="text" id="UDPsize" name="UDPsize" value="1232" required="">
                </span>
                <span>
                    <span class="infotag" hx-get="dig/info/tsig" hx-target="#infobox" hx-swap="innerHTML">TSIG: </span>
                    <input type="text" id="Tsig" name="Tsig" value="" placeholder="hmac-algorithm:name:key"></span>
                
            </details>
        </div>

        </form>
    </div>
</section>
<section class="main">

 
        <input type="checkbox" id="wide-term" value="true" name="wide-term"> 
	<div id="terminal" class=""><div class="iconBox">
<label for="wide-term">
<span><svg class="expandIcon" viewBox="0 0 21 23" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M5.4 3h13.2A2.4 2.4 0 0 1 21 5.4v13.2a2.4 2.4 0 0 1-2.4 2.4H5.4A2.4 2.4 0 0 1 3 18.6V5.4A2.4 2.4 0 0 1 5.4 3Zm7.307 5.293a1 1 0 0 0-1.414 0l-4 4a1 1 0 1 0 1.414 1.414L12 10.414l3.293 3.293a1 1 0 0 0 1.414-1.414l-4-4Z" fill="#000000"></path>
        </svg>
</span>
</label>
</div>
<table class="fade-in">
<tbody><tr>
<td colspan="5">; &lt;&lt;&gt;&gt; NerDiG 0.9.0 &lt;&lt;&gt;&gt;</td>
</tr>
<tr>
<td colspan="5">;; Sending:</td>
</tr>
<tr>
<td colspan="5">
;; -&gt;&gt;HEADER&lt;&lt;-<span class="QUERY info" hx-get="dig/info/opcode" hx-target="#infobox" hx-swap="innerHTML">
;; opcode: QUERY,
</span>
<span class="NOERROR info" hx-get="dig/info/rcode" hx-target="#infobox" hx-swap="innerHTML">
status: NOERROR,
</span>
<span class="info" hx-get="dig/info/message-id" hx-target="#infobox" hx-swap="innerHTML">
id: 62591
</span>
</td>
</tr>
<tr>
<td colspan="5">
<span class="flags info" hx-get="dig/info/flags" hx-target="#infobox" hx-swap="innerHTML">
;; flags: 
</span>
<span class="QR info unset" hx-get="dig/info/flag-QR" hx-target="#infobox" hx-swap="innerHTML">
QR
</span>
<span class="RD info unset" hx-get="dig/info/flag-RD" hx-target="#infobox" hx-swap="innerHTML">
RD
</span>
<span class="RA info unset" hx-get="dig/info/flag-RA" hx-target="#infobox" hx-swap="innerHTML">
RA
</span>
<span class="AA info unset" hx-get="dig/info/flag-AA" hx-target="#infobox" hx-swap="innerHTML">
AA
</span>
<span class="AD info set" hx-get="dig/info/flag-AD" hx-target="#infobox" hx-swap="innerHTML">
AD
</span>
<span class="CD info unset" hx-get="dig/info/flag-CD" hx-target="#infobox" hx-swap="innerHTML">
CD
</span>
<span class="TC info unset" hx-get="dig/info/flag-TC" hx-target="#infobox" hx-swap="innerHTML">
TC
</span>
<span class="sepcolon">;</span><span class="info" hx-get="dig/info/count-QUERY" hx-target="#infobox" hx-swap="innerHTML">
QUERY: 1,
</span>
<span class="info" hx-get="dig/info/count-ANSWER" hx-target="#infobox" hx-swap="innerHTML">
ANSWER: 0,
</span>
<span class="info" hx-get="dig/info/count-AUTHORITY" hx-target="#infobox" hx-swap="innerHTML">
AUTHORITY: 0,
</span>
<span class="info" hx-get="dig/info/count-ADDITIONAL" hx-target="#infobox" hx-swap="innerHTML">
ADDITIONAL: 1
</span>
</td>
</tr>
<tr class="">
<td colspan="5">
<span class="info" hx-get="dig/info/section-OPT" hx-target="#infobox" hx-swap="innerHTML">
;; OPT PSEUDOSECTION:
</span>
</td></tr>
<tr>
<td colspan="5">
<span class="info" hx-get="dig/info/opt-EDNS0" hx-target="#infobox" hx-swap="innerHTML">
; EDNS: version 0; 
</span>
<span class="info" hx-get="dig/info/flag-DO" hx-target="#infobox" hx-swap="innerHTML">
flags:; 
</span>
<span class="info" hx-get="dig/info/opt-UDP" hx-target="#infobox" hx-swap="innerHTML">
udp: 1232
</span>
</td>
</tr>
<tr>
<td colspan="5" class="spacer"></td></tr>
<tr class="">
<td colspan="5">
<span class="info" hx-get="dig/info/section-QUESTION" hx-target="#infobox" hx-swap="innerHTML">
;; QUESTION SECTION:
</span>
</td>
</tr>
<tr><td colspan="5">
<span class="info" hx-get="dig/info/placeholder" hx-target="#infobox" hx-swap="innerHTML">
;trasigdnssec.se.	IN	 A
</span>
</td>
</tr>
<tr>
<td colspan="5" class="spacer"></td></tr>
<tr class="unset">
<td colspan="5">
<span class="info" hx-get="dig/info/section-ANSWER" hx-target="#infobox" hx-swap="innerHTML">
;; ANSWER SECTION:
</span>
</td>
</tr>
<tr>
<td colspan="5" class="spacer"></td></tr>
<tr class="unset">
<td colspan="5">
<span class="info" hx-get="dig/info/section-AUTHORITY" hx-target="#infobox" hx-swap="innerHTML">
;; AUTHORITY SECTION:
</span>
</td>
</tr>
<tr>
<td colspan="5" class="spacer"></td></tr>
<tr class="unset">
<td colspan="5">
<span class="info" hx-get="dig/info/section-ADDITIONAL" hx-target="#infobox" hx-swap="innerHTML">
;; ADDITIONAL SECTION:
</span>
</td>
</tr>
<tr>
<td colspan="5" class="spacer"></td></tr>
<tr>
<td colspan="5">;; Got answer:</td>
</tr>
<tr>
<td colspan="5">
;; -&gt;&gt;HEADER&lt;&lt;-<span class="QUERY info" hx-get="dig/info/opcode" hx-target="#infobox" hx-swap="innerHTML">
;; opcode: QUERY,
</span>
<span class="SERVFAIL info" hx-get="dig/info/rcode" hx-target="#infobox" hx-swap="innerHTML">
status: SERVFAIL,
</span>
<span class="info" hx-get="dig/info/message-id" hx-target="#infobox" hx-swap="innerHTML">
id: 62591
</span>
</td>
</tr>
<tr>
<td colspan="5">
<span class="flags info" hx-get="dig/info/flags" hx-target="#infobox" hx-swap="innerHTML">
;; flags: 
</span>
<span class="QR info set" hx-get="dig/info/flag-QR" hx-target="#infobox" hx-swap="innerHTML">
QR
</span>
<span class="RD info unset" hx-get="dig/info/flag-RD" hx-target="#infobox" hx-swap="innerHTML">
RD
</span>
<span class="RA info set" hx-get="dig/info/flag-RA" hx-target="#infobox" hx-swap="innerHTML">
RA
</span>
<span class="AA info unset" hx-get="dig/info/flag-AA" hx-target="#infobox" hx-swap="innerHTML">
AA
</span>
<span class="AD info unset" hx-get="dig/info/flag-AD" hx-target="#infobox" hx-swap="innerHTML">
AD
</span>
<span class="CD info unset" hx-get="dig/info/flag-CD" hx-target="#infobox" hx-swap="innerHTML">
CD
</span>
<span class="TC info unset" hx-get="dig/info/flag-TC" hx-target="#infobox" hx-swap="innerHTML">
TC
</span>
<span class="sepcolon">;</span><span class="info" hx-get="dig/info/count-QUERY" hx-target="#infobox" hx-swap="innerHTML">
QUERY: 1,
</span>
<span class="info" hx-get="dig/info/count-ANSWER" hx-target="#infobox" hx-swap="innerHTML">
ANSWER: 0,
</span>
<span class="info" hx-get="dig/info/count-AUTHORITY" hx-target="#infobox" hx-swap="innerHTML">
AUTHORITY: 0,
</span>
<span class="info" hx-get="dig/info/count-ADDITIONAL" hx-target="#infobox" hx-swap="innerHTML">
ADDITIONAL: 1
</span>
</td>
</tr>
<tr>
<td colspan="5" class="spacer"></td></tr>
<tr class="">
<td colspan="5">
<span class="info" hx-get="dig/info/section-OPT" hx-target="#infobox" hx-swap="innerHTML">
;; OPT PSEUDOSECTION:
</span>
</td></tr>
<tr>
<td colspan="5">
<span class="info" hx-get="dig/info/opt-EDNS0" hx-target="#infobox" hx-swap="innerHTML">
; EDNS: version 0; 
</span>
<span class="info" hx-get="dig/info/flag-DO" hx-target="#infobox" hx-swap="innerHTML">
flags:; 
</span>
<span class="info" hx-get="dig/info/opt-UDP" hx-target="#infobox" hx-swap="innerHTML">
udp: 1232
</span>
</td>
</tr>
<tr>
<td colspan="5">
<span class="info" hx-get="dig/info/opt-EDNS0_EDE" hx-target="#infobox" hx-swap="innerHTML">
; EDE: 0 (Other): (no local cache to fulfill non recursion (RD=0) request)
</span>
</td>
</tr>
<tr>
<td colspan="5" class="spacer"></td></tr>
<tr class="">
<td colspan="5">
<span class="info" hx-get="dig/info/section-QUESTION" hx-target="#infobox" hx-swap="innerHTML">
;; QUESTION SECTION:
</span>
</td>
</tr>
<tr><td colspan="5">
<span class="info" hx-get="dig/info/placeholder" hx-target="#infobox" hx-swap="innerHTML">
;trasigdnssec.se.	IN	 A
